{
  "name": "trimira-launcher",
  "version": "1.0.1",
  "description": "Trimira Game Launcher",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && node build-electron.js && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "electron-updater": "^6.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.6",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-is-dev": "^3.0.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "ru.trimira.launcher",
    "productName": "Trimira Launcher",
    "artifactName": "Trimira-Launcher-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icons/launcher.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "devastatedq",
        "repo": "launcher"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trimira",
      "installerIcon": "resources/icons/launcher.ico",
      "uninstallerIcon": "resources/icons/launcher.ico",
      "installerHeaderIcon": "resources/icons/launcher.ico"
    }
  },
  "allowScripts": {
    "better-sqlite3@9.6.0": true,
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
